ENABLE_STRATEGY_SESSION_FILTER=true
STRATEGY_SESSION_DRY_RUN=false
STRATEGY_SESSION_FAIL_OPEN=false
SESSION_ENTER_GUARD_ENABLED=true
NEWS_SECTOR_FILTER=true

# -----------------------------------------------------------------------------
# ai-engine worker toggles
# -----------------------------------------------------------------------------
ENABLE_STRATEGY_SCANNER=true
# Additive G01-G07 lineage kill switch. Keep false until shadow activation is approved.
ENABLE_STRATEGY_FAMILY_LINEAGE=false
# Compute normalized family scores for observation only; never changes ENTER.
ENABLE_STRATEGY_FAMILY_SHADOW_SCORING=false
# Master live-policy switch. Off restores legacy RR/decision routing immediately.
ENABLE_STRATEGY_FAMILY_LIVE_ROUTING=false
# Single strategy signal publisher. PYTHON is the production default; JAVA
# temporarily restores the manual Java strategy endpoints for rollback.
STRATEGY_EXECUTION_OWNER=PYTHON
# Candidate Redis pools have one writer. Python owns the live builder; Java only reads.
CANDIDATE_POOL_OWNER=PYTHON
ENABLE_CONFIRM_GATE=false
# ENABLE_CONFIRM_GATE=true일 때 telegram-bot이 human_confirm_queue를 폴링하는 간격(ms)
CONFIRM_POLL_INTERVAL_MS=2000
ENABLE_MONITOR=true
ENABLE_STATUS_REPORT=true
ENABLE_POSITION_MONITOR=true
ENABLE_POSITION_REASSESSMENT=true
ENABLE_OVERNIGHT_WORKER=true
ENABLE_VI_WATCH_WORKER=true
# Candidate-pool recovery only accepts a recently released VI cache entry.
VI_SUPPLEMENT_RELEASE_MAX_AGE_MS=60000
# Prevent the same cached release from being supplemented throughout its 10m watch window.
VI_SUPPLEMENT_DEDUP_SEC=660
ENABLE_CANDIDATE_BUILDER=true
# candidates_builder.py 메인 루프가 장 세션별 빌드(pre_market/opening_recovery/
# intraday/s12_only)를 실제로 도는지 여부. 코드 기본값은 false — 이 값이 없으면
# 후보풀 빌드 루프 전체가 조용히 멈춘다. 실 운영에서는 반드시 true.
ENABLE_SESSION_CANDIDATE_BUILDER=true
# 후보풀 빌드 단계별 메타(raw_count/filtered_count 등)를 Redis에 기록할지 여부. 관측용, 기본 false.
ENABLE_CANDIDATES_META=false
# S3/S5 후보풀 빌드 지연시간을 상태 키에 기록할지 여부. 관측용, 기본 false.
ENABLE_S3S5_LATENCY_STATUS=false
ENABLE_HOLD_MONITOR_WORKER=true
REVERSAL_CLAUDE_ENABLED=true

