# -----------------------------------------------------------------------------
# Kiwoom API
# -----------------------------------------------------------------------------
# 실무 가이드(레포 오너, 2026-08-05): 키움 공식 "초당 5건"은 이론상 상한이며,
# 서버 응답 지연·자동 속도조절 탓에 실제로는 안정적으로 채우기 어렵다.
# 민감한 엔드포인트(차트/대량조회/페이지네이션)는 최소 1.0초, 일반 호출도
# 최소 0.8~1.0초 간격을 두고, 실패 시 지수 백오프(0.5s→1s→2s)로 재시도하며,
# 다수 요청은 TR별 FIFO 큐(직렬화)로 처리한다. 아래 KIWOOM_REST_RATE_PER_TR
# (light)/KIWOOM_REST_RATE_HEAVY_TR(heavy)/KIWOOM_GLOBAL_RATE_LIMIT_* 가 이
# 정책을 구현한다. http_utils.py::_KiwoomRateLimiter 참고.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_WS_URL=wss://api.kiwoom.com:10000
KIWOOM_MODE=real
KIWOOM_API_INTERVAL=0.8
JAVA_WS_ENABLED=false
WS_GROUP_MAX_ITEMS=100
WS_DYNAMIC_REG_ENABLED=false
WS_CONTROL_ACK_TIMEOUT_SEC=10
HEALTH_EXPOSE_SESSION=true
S1_KA10029_TRADE_QTY_CONDITION=0
BYPASS_MARKET_HOURS=false

# -----------------------------------------------------------------------------
# Toss API (2026-08-11 연동: 실지수 장세연동, 시장 수급, 종목검색 랭킹, 공매도/신용/대차)
# WTS 설정 > Open API에서 client_id/client_secret 발급 및 허용 IP 등록 필요.
# docs/toss_invest_openapi_claude_required.md 참고. 계좌/자산/주문 API는 구현하지 않는다.
# -----------------------------------------------------------------------------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ENABLED=false
TOSS_BASE_URL=https://openapi.tossinvest.com
REGIME_INVESTOR_FLOW_ENABLED=true
TOSS_RANKING_SUPPLEMENT_ENABLED=true
TOSS_RANKING_SUPPLEMENT_LIMIT=20
TOSS_CANDLE_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# Claude / Anthropic
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_ANALYST_TIMEOUT_SEC=30
CLAUDE_ANALYST_MINUTE_SCOPE=5
MAX_CLAUDE_CALLS_PER_DAY=100
MAX_CLAUDE_HOLD_RECHECK_CALLS_PER_DAY=150
SPRING_TASK_SCHEDULING_POOL_SIZE=4
MAX_NEWS_CLAUDE_CALLS=10
NEWS_MAX_TOKENS=4000
NEWS_CLAUDE_TIMEOUT_SEC=180
NEWS_RETRY_ON_MAX_TOKENS=true
NEWS_RETRY_MAX_TOKENS=2000
NEWS_PROMPT_ITEM_LIMIT=18
NEWS_PROMPT_DESC_CHARS=90

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PRIMARY_CHAT_ID=
TELEGRAM_DRY_RUN=false
# Threads 게시 전 관리자 미리보기용 채팅 ID (THREADS_ENABLED=false여도 동작)
# 설정하면 ENTER/RULE_ONLY 신호와 브리핑을 이 채팅으로 미리 보여줌
# 필터 통과 여부(R:R·시총)도 함께 표시됨
TELEGRAM_THREADS_CHAT_ID=
POLL_INTERVAL_MS=2000
# AI_SCORE_THRESHOLD (ai-engine scorer.py)와 동일 값으로 유지할 것 (현재 둘 다 62)
MIN_AI_SCORE=62
# /score command HTTP timeout to ai-engine, including Claude analysis slack.
SCORE_COMMAND_TIMEOUT_MS=95000

# -----------------------------------------------------------------------------
# Internal service URLs
# -----------------------------------------------------------------------------
API_BASE_URL=http://api-orchestrator:5050
API_ORCHESTRATOR_BASE_URL=http://api-orchestrator:5050
SERVER_PORT=5050
AI_ENGINE_URL=http://ai-engine:8082

