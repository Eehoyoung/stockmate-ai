# -----------------------------------------------------------------------------
# Data cleanup
# -----------------------------------------------------------------------------
DATA_CLEANUP_CRON="0 30 20 * * *"
CLEANUP_WS_TICK_LEGACY_TRUNCATE_ENABLED=true
CLEANUP_WS_TICK_PARTITION_RETENTION_ENABLED=true
CLEANUP_WS_TICK_PARTITION_RETENTION_DRY_RUN=false
CLEANUP_WS_TICK_RETAIN_DAYS=3
CLEANUP_VI_EVENTS_RETAIN_DAYS=3
CLEANUP_CANDIDATE_POOL_HISTORY_RETAIN_DAYS=7
CLEANUP_DAILY_INDICATORS_RETAIN_DAYS=30
CLEANUP_AI_CANCEL_SIGNAL_RETAIN_DAYS=30
CLEANUP_RULE_CANCEL_SIGNAL_RETAIN_DAYS=30
CLEANUP_OVERNIGHT_EVALUATIONS_RETAIN_DAYS=90
CLEANUP_INACTIVE_TOKEN_RETAIN_DAYS=7
CLEANUP_LOG_FILES_ENABLED=true
CLEANUP_LOG_DIR=/app/logs
CLEANUP_LOG_RETAIN_DAYS=2

# -----------------------------------------------------------------------------
# Threads API (Meta)
# 활성화 조건:
# 1) Meta Threads 앱을 만들고 THREADS_APP_ID / THREADS_APP_SECRET 값을 채운다.
# 2) 아래 명령으로 OAuth를 1회 완료해 Redis에 threads:access_token,
#    threads:token_expiry, threads:token_refreshed를 저장한다.
#      docker compose exec telegram-bot node scripts/threads_auth.js
#    또는 로컬에서:
#      node telegram-bot/scripts/threads_auth.js
# 3) 스크립트가 출력한 THREADS_USER_ID를 채우고 THREADS_ENABLED=true로 바꾼다.
# 4) telegram-bot 컨테이너를 재시작해야 런타임 env가 반영된다.
#
# 주의:
# - THREADS_ENABLED=true여도 THREADS_APP_ID 또는 THREADS_USER_ID가 비어 있으면
#   봇은 Threads 발행을 건너뛴다.
# - access token은 .env에 넣지 않고 Redis에 저장한다.
# - THREADS_MIN_MARKET_CAP_EOK는 Threads 공개 게시 제외 기준이다.
#   기본 1000 = 시가총액 1,000억 원 미만 제외.
# - THREADS_MIN_RR은 Threads 공개 게시 R:R 하한이다.
#   기본 1.3 (내부 엔진 min_rr 하한 1.45에 근접하는 공개 SNS 기준).
#   TP/SL 데이터 없는 신호는 R:R 계산 불가로 이 필터를 통과한다.
# -----------------------------------------------------------------------------
THREADS_ENABLED=false
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_REDIRECT_URI=https://localhost/auth/threads
THREADS_MIN_MARKET_CAP_EOK=1000
THREADS_MIN_RR=1.3
