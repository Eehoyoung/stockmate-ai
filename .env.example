# -----------------------------------------------------------------------------
# Kiwoom API
# -----------------------------------------------------------------------------
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_WS_URL=wss://api.kiwoom.com:10000
KIWOOM_MODE=real
KIWOOM_API_INTERVAL=0.25
JAVA_WS_ENABLED=false
BYPASS_MARKET_HOURS=false

# -----------------------------------------------------------------------------
# Claude / Anthropic
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_ANALYST_TIMEOUT_SEC=30
CLAUDE_ANALYST_MINUTE_SCOPE=5
MAX_CLAUDE_CALLS_PER_DAY=100
MAX_NEWS_CLAUDE_CALLS=10
NEWS_MAX_TOKENS=4000
NEWS_CLAUDE_TIMEOUT_SEC=180
NEWS_RETRY_ON_MAX_TOKENS=true
NEWS_RETRY_MAX_TOKENS=2000
NEWS_PROMPT_ITEM_LIMIT=18
NEWS_PROMPT_DESC_CHARS=90

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PRIMARY_CHAT_ID=
TELEGRAM_DRY_RUN=false
# Threads 게시 전 관리자 미리보기용 채팅 ID (THREADS_ENABLED=false여도 동작)
# 설정하면 ENTER/RULE_ONLY 신호와 브리핑을 이 채팅으로 미리 보여줌
# 필터 통과 여부(R:R·시총)도 함께 표시됨
TELEGRAM_THREADS_CHAT_ID=
POLL_INTERVAL_MS=2000
# AI_SCORE_THRESHOLD (ai-engine scorer.py)와 동일 값으로 유지할 것 (현재 둘 다 62)
MIN_AI_SCORE=62
# /score command HTTP timeout to ai-engine, including Claude analysis slack.
SCORE_COMMAND_TIMEOUT_MS=95000

# -----------------------------------------------------------------------------
# Internal service URLs
# -----------------------------------------------------------------------------
API_BASE_URL=http://api-orchestrator:8080
API_ORCHESTRATOR_BASE_URL=http://api-orchestrator:8080
AI_ENGINE_URL=http://ai-engine:8082

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=SMA
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
PG_WRITER_ENABLED=true
WS_DB_0D_MIN_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# Security / encryption
# -----------------------------------------------------------------------------
ENCRYPT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Runtime / logging
# -----------------------------------------------------------------------------
TZ=Asia/Seoul
LOG_LEVEL=INFO
SERVICE_NAME=telegram-bot
LOG_FILE=../../logs/telegram-bot.log

# -----------------------------------------------------------------------------
# Health ports
# NOTE: HEALTH_PORT is currently used by websocket-listener.
# telegram-bot currently falls back to HEALTH_PORT too; this should be split to
# TELEGRAM_HEALTH_PORT in the OCI deployment work.
# -----------------------------------------------------------------------------
HEALTH_PORT=8081
AI_HEALTH_PORT=8082
TELEGRAM_HEALTH_PORT=3001

# -----------------------------------------------------------------------------
# api-orchestrator trading controls
# -----------------------------------------------------------------------------
JPA_DDL_AUTO=validate
SIGNAL_DUPLICATE_TTL=7200
MAX_DAILY_SIGNALS=30
SECTOR_OVERHEAT_THRESHOLD=3
STOCK_COOLDOWN_MINUTES=30
SWING_STRATEGIES=S3_INST_FRGN,S5_PROG_FRGN,S7_ICHIMOKU_BREAKOUT,S8_GOLDEN_CROSS,S9_PULLBACK_SWING,S10_NEW_HIGH,S11_FRGN_CONT,S12_CLOSING,S13_BOX_BREAKOUT,S14_OVERSOLD_BOUNCE,S15_MOMENTUM_ALIGN
