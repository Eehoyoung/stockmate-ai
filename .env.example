# ── Kiwoom REST rate limiter (2026-08-05 재설계) ────────────────────────────
# light TR(일반 조회, 기본 1.25req/s = 0.8s 간격)
KIWOOM_REST_RATE_PER_TR=1.25
# heavy TR(차트/대량조회/페이지네이션, 기본 1.0req/s = 1.0s 간격).
# 대상 TR 목록은 http_utils.py::_DEFAULT_HEAVY_TR_IDS 참고
# (ka10025,ka10047,ka10055,ka10059,ka10061,ka10064,ka10080,ka10081,ka90003,ka90008,ka90009).
# 콤마 목록을 지정하면 기본 목록을 덮어쓴다.
KIWOOM_REST_RATE_HEAVY_TR=1.0
# KIWOOM_HEAVY_TR_IDS=ka10025,ka10047,ka10055,ka10059,ka10061,ka10064,ka10080,ka10081,ka90003,ka90008,ka90009
KIWOOM_GLOBAL_RATE_LIMIT_ENABLED=true
# light TR 교차프로세스(Python/Java) 잠금 간격
KIWOOM_GLOBAL_RATE_LIMIT_INTERVAL_MS=800
# heavy TR 교차프로세스(Python/Java) 잠금 간격
KIWOOM_GLOBAL_RATE_LIMIT_INTERVAL_MS_HEAVY=1000
# 장중 동시 전략의 정상 FIFO 대기가 false "deadline exceeded"로 드롭되지
# 않도록 15초까지 대기한다(무한 대기는 아님 — 초과 시 여전히 실패 처리).
KIWOOM_GLOBAL_RATE_LIMIT_WAIT_MS=15000
KIWOOM_GLOBAL_RATE_LIMIT_FALLBACK_INTERVAL_MS=1000
KIWOOM_GLOBAL_RATE_LIMIT_UNAVAILABLE_BACKOFF_MS=30000
KIWOOM_GLOBAL_RATE_LIMIT_KEY=kiwoom:global_rate_limit:lock
STOCK_ARBITRATION_TTL_SEC=1800

