# S12 거래대금상위 풀 동시 충족 가점 (풀은 하드 게이트가 아니다)
S12_POOL_BONUS=5.0
S13_POOL_READ_LIMIT=180
S13_SCAN_LIMIT=60
S14_POOL_READ_LIMIT=180
S14_SCAN_LIMIT=60
S15_POOL_READ_LIMIT=180
S15_SCAN_LIMIT=60
S1_FALLBACK_MIN_STRENGTH=130.0
