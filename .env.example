# -----------------------------------------------------------------------------
# Scoring / risk policy
# -----------------------------------------------------------------------------
AI_SCORE_THRESHOLD=60.0
RR_HARD_CANCEL_THRESHOLD=0.8
RR_CAUTION_THRESHOLD=1.2
HOLD_TO_ENTER_MIN_AI_SCORE=80.0
HOLD_MONITOR_INTERVAL_SEC=5.0
HOLD_MONITOR_RECHECK_SEC=10.0
HOLD_MONITOR_AI_COOLDOWN_SEC=300.0
HOLD_MONITOR_MAX_AI_RECHECKS=2
HOLD_MONITOR_MIN_SCORE_DELTA=5.0
HOLD_MONITOR_BATCH_LIMIT=20
HOLD_MONITOR_CLOSE_HHMM=15:30
HOLD_MONITOR_TTL_SEC=43200
HOLD_MONITOR_USE_REST_FALLBACK=false
HOLD_MONITOR_MAX_REST_CALLS_PER_MIN=30
HOLD_MONITOR_MAX_AGE_SEC=1800
# Keep >= HOLD_MONITOR_MAX_AGE_SEC / HOLD_MONITOR_RECHECK_SEC (1800/10=180) so the age
# limit is the real ceiling, not this attempt count. 6 was the pre-2026-07-27 default and
# cut the observation window to ~60s instead of the intended ~30min.
HOLD_MONITOR_MAX_ATTEMPTS=180
# Queue market-data freshness: retry stale inputs, bound payload fallback age,
# and optionally refresh tick through REST. The strict guard blocks aggressive
# ENTER decisions when every refreshed market-data field came from REST.
ENABLE_SCORING_DATA_RETRY=true
ENABLE_TICK_REST_FALLBACK=false
STRICT_REST_ENTER_GUARD=true
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_SEND_RETRY_BASE_MS=500
# Max age (ms) of REST-only market data still allowed to produce an ENTER.
# The guard now judges freshness, not source: REST is fetched on demand and
# typically lands ~0.1s old, so it passes; only genuinely delayed responses
# are blocked.
REST_ENTER_MAX_AGE_MS=3000
# 전략별 chart 데이터 보강(P2) 실행 여부. 기본 false — 켜면 queue_worker가
# 신호당 chart 재조회를 추가로 수행한다(Kiwoom 호출 증가).
ENABLE_CHART_RETRY=false
GS_QUANT_SHADOW_ENABLED=false
QUEUE_SIGNAL_MAX_AGE_SEC=30
# Java S11 applies expensive REST enrichment only to the top N primary candidates.
STRATEGY_S11_ENRICHMENT_TOP_N=5
MIN_RR_RATIO=1.3
TP_SL_STRATEGY_VERSION=ta_v2_2026_04
SLIP_FEE_KOSPI=0.0035
SLIP_FEE_KOSDAQ=0.0045

